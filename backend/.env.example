# ================================
# DATABASE CONFIGURATION
# ================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/complaints

# ================================
# CORS CONFIGURATION
# ================================
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ================================
# APPLICATION CONFIGURATION
# ================================
APP_NAME=Complaint Management API
APP_VERSION=1.0.0
DEBUG=False

# ================================
# AZURE DEPLOYMENT (Production)
# ================================
# For Azure deployment, set these in Azure Portal > App Service > Configuration
# DATABASE_URL=postgresql://complainadmin:YOUR_PASSWORD@complaint-db.postgres.database.azure.com:5432/complaints?sslmode=require
# CORS_ORIGINS=https://your-frontend.azurewebsites.net
# DEBUG=False

